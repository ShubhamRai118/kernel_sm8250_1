	qcom,fg-batt-temp-hyst = <1>;
	qcom,fg-batt-temp-delta = <6>;
	qcom,soc-scale-vbatt-mv = <3600>;
	qcom,fg-force-load-profile;
	qcom,ki-coeff-chg-med-hi-thresh-ma = <1000>;
	qcom,ki-coeff-chg-low-med-thresh-ma = <500>;
	qcom,ffc-ki-coeff-chg-med-hi-thresh-ma = <3900>;
	qcom,ffc-ki-coeff-chg-low-med-thresh-ma = <3500>;
	qcom,fg-esr-cal-soc-thresh = <50 90>;
	qcom,fg-esr-cal-temp-thresh = <10 40>;
	qcom,fg-esr-timer-chg-fast = <0 7>;
	qcom,fg-esr-timer-dischg-fast = <0 7>;
	qcom,fg-esr-timer-chg-slow = <0 96>;
	qcom,fg-esr-timer-dischg-slow = <0 96>;
	qcom,fg-esr-cal-soc-thresh-2 = <50 4000>;
	qcom,fg-esr-cal-temp-thresh-2 = <10 40>;
	qcom,fg-esr-timer-chg-fast-2 = <0 7>;
	qcom,fg-esr-timer-dischg-fast-2 = <0 7>;
	qcom,fg-esr-timer-chg-slow-2 = <0 96>;
	qcom,fg-esr-timer-dischg-slow-2 = <0 96>;
	qcom,fg-esr-flt-sel = <2>;
	qcom,fg-esr-pulse-thresh-ma = <40>;
	qcom,fg-esr-meas-curr-ma = <60>;
	qcom,fg-ffc-esr-pulse-thresh-ma = <120>;
	qcom,fg-ffc-esr-meas-curr-ma = <100>;
	//qcom,fg-increase-100soc-time;
	qcom,fg-increase-100soc-time-2;
	qcom,shutdown-delay-enable;
};

&soc {
	cp_qc30 {
		compatible = "xiaomi,cp-qc30";
		status = "ok";
		mi,qc3-bat-volt-max = <4480>;
		mi,qc3-bat-curr-max = <3600>;
		mi,qc3-bus-volt-max = <12000>;
		mi,qc3-bus-curr-max = <2100>;
		mi,qc3-battery-warm-th = <450>;
		mi,use-qcom-gauge;
		mi,support-qc3p5-without-smb;
		//mi,cp-sec-enable;
	};

	usbpd_pm {
		compatible = "xiaomi,usbpd-pm";
		status = "ok";
		mi,pd-bat-volt-max = <4480>;
		mi,pd-bat-curr-max = <12500>;
		mi,pd-bus-volt-max = <12000>;
		mi,pd-bus-curr-max = <3000>;
		mi,pd-bus-curr-compensate  = <0>;
		mi,pd-non-ffc-bat-volt-max = <4450>;
		mi,pd-battery-warm-th = <450>;
		mi,step-charge-high-vol-curr-max = <5400000>;
		mi,use-qcom-gauge;
		//mi,cp-sec-enable;
		mi,therm-level-threshold = <12>;
	};

	alioth_batterydata: qcom,battery-data {
		qcom,batt-id-range-pct = <15>;
		#include "fg-gen4-batterydata-apollo-sun-5000mah.dtsi"
		#include "fg-gen4-batterydata-alioth-sunwoda-5000mah.dtsi"
		#include "fg-gen4-batterydata-alioth-atl-5000mah.dtsi"
